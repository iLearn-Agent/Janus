# Cloud evolution Worker configuration.
#
# Labels used below:
#   Required    - must be replaced or confirmed for production.
#   Optional    - may keep the shown runtime default.
#   Conditional - required only for the selected provider or feature.
#
# For secrets, set either NAME or NAME_FILE, never both. This example uses
# Docker Secret paths through the *_FILE form.

# Required for a production deployment.
NODE_ENV=production

# Required: Worker-only PostgreSQL login. Do not reuse API or Migrator roles.
EVOLUTION_WORKER_DATABASE_URL=postgres://janus_worker_login:replace-me@postgres:5432/janus

# Required provider choice, option A: explicit Responses-compatible Provider.
# Base URL, API key and primary model are all required for this option.
JANUS_EVOLUTION_PROVIDER_BASE_URL=https://api.example.com/v1
JANUS_EVOLUTION_PROVIDER_API_KEY_FILE=/run/secrets/worker_provider_api_key
JANUS_EVOLUTION_MODEL=replace-with-model-id

# Optional: review/evaluation model. Defaults to the primary model if omitted.
JANUS_EVOLUTION_REVIEW_MODEL=replace-with-review-model-id

# Alternative provider choice, option B: configure Codex through config.toml and
# auth.json under this directory, then remove/leave unset all option A values.
# JANUS_EVOLUTION_CODEX_HOME=/var/lib/janus/codex

# Required for production evolution encryption.
# Each active key ID must exist in its corresponding keyring.
JANUS_EVOLUTION_ACTIVE_KEY_ID=evolution-key-1
JANUS_EVOLUTION_KEYS_JSON_FILE=/run/secrets/evolution_keys
JANUS_EVOLUTION_WORKER_ACTIVE_KEY_ID=evolution-worker-1
JANUS_EVOLUTION_WORKER_PUBLIC_KEYS_JSON_FILE=/run/secrets/evolution_worker_public_keys
JANUS_EVOLUTION_WORKER_PRIVATE_KEYS_JSON_FILE=/run/secrets/evolution_worker_private_keys

# Required when Cloud Task Memory is enabled.
# Worker receives both halves; API receives only the public keyring.
JANUS_TASK_MEMORY_CLOUD_ACTIVE_KEY_ID=task-memory-1
JANUS_TASK_MEMORY_CLOUD_PUBLIC_KEYS_JSON_FILE=/run/secrets/task_memory_public_keys
JANUS_TASK_MEMORY_CLOUD_PRIVATE_KEYS_JSON_FILE=/run/secrets/task_memory_private_keys

# Optional: Worker scheduling and batch sizes. Defaults are shown.
JANUS_EVOLUTION_WORKER_INTERVAL_MS=15000
JANUS_EVOLUTION_WORKER_BATCH_SIZE=2
JANUS_EVOLUTION_BACKFILL_BATCH_SIZE=100
JANUS_EVOLUTION_REWRAP_BATCH_SIZE=100
JANUS_CLUSTER_WORKER_BATCH_SIZE=2

# Required for the standard Community object-storage integration.
JANUS_S3_ENDPOINT=http://minio:9000

# Optional: region defaults to us-east-1 when omitted.
JANUS_S3_REGION=us-east-1

# Required: Bucket, Worker access-key ID and its secret access key.
# Bucket and access-key ID must match compose.env and storage.env.
JANUS_S3_BUCKET=janus-sync
JANUS_S3_ACCESS_KEY_ID=janus-worker
JANUS_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/worker_s3_secret

# Optional: keep true for MinIO; many hosted S3 services use false.
JANUS_S3_FORCE_PATH_STYLE=true
