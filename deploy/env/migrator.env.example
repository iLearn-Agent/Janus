# Database Migrator configuration.
#
# Required    - must be replaced or confirmed for production.
# Optional    - may keep the shown value.

# Required for production role isolation. The Docker image also sets this.
NODE_ENV=production

# Required: Migrator-only PostgreSQL login. Do not reuse API or Worker roles.
DATABASE_MIGRATOR_URL=postgres://janus_migrator_login:replace-me@postgres:5432/janus

# Optional informational pin. The Migrator currently uses the baseline ID
# compiled into the source; changing this value does not select another schema.
JANUS_DATABASE_BASELINE_ID=baseline_sync8_081
