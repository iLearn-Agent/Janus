# MinIO bootstrap configuration for the standard Community deployment.
# Every value in this file is required. Secret values use Docker Secret paths.
# Set either NAME or NAME_FILE for a secret, never both.

# Required: MinIO administrator identity and password.
# MINIO_ROOT_USER must match compose.env.
MINIO_ROOT_USER=replace-with-random-admin-user
MINIO_ROOT_PASSWORD_FILE=/run/secrets/minio_root_password

# Required: API-scoped object-storage identity and secret access key.
# The access-key ID must match compose.env and api.env.
JANUS_MINIO_API_ACCESS_KEY=janus-api
JANUS_MINIO_API_SECRET_KEY_FILE=/run/secrets/api_s3_secret

# Required: Worker-scoped object-storage identity and secret access key.
# The access-key ID must match compose.env and worker.env.
JANUS_MINIO_WORKER_ACCESS_KEY=janus-worker
JANUS_MINIO_WORKER_SECRET_KEY_FILE=/run/secrets/worker_s3_secret

# Required: Bucket created by the MinIO initialization job.
# Must match compose.env, api.env and worker.env.
JANUS_S3_BUCKET=janus-sync
