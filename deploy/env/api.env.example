# Cloud API configuration.
#
# Labels used below:
#   Required    - must be replaced or confirmed for production.
#   Optional    - may keep the shown runtime default.
#   Conditional - required only when the named feature is enabled.
#
# For secrets, set either NAME or NAME_FILE, never both. This example uses
# Docker Secret paths through the *_FILE form.

# Required for a production deployment.
NODE_ENV=production

# Optional: listener settings. Defaults are shown.
JANUS_API_HOST=0.0.0.0
PORT=8787

# Required: externally reachable HTTPS origin, without a trailing slash.
JANUS_PUBLIC_BASE_URL=https://janus.example.com

# Required: API-only PostgreSQL login. Do not reuse Worker or Migrator roles.
DATABASE_URL=postgres://janus_api_login:replace-me@postgres:5432/janus

# Required: independent secrets for access tokens and email codes.
JWT_SECRET_FILE=/run/secrets/api_jwt_secret
EMAIL_CODE_SECRET_FILE=/run/secrets/api_email_code_secret

# Optional: authentication lifetime settings. Defaults are shown.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_CODE_TTL_MINUTES=10

# Required for account email delivery: sender identity and SMTP endpoint.
# MAIL_PROVIDER may be omitted because SMTP_HOST automatically selects SMTP.
MAIL_PROVIDER=smtp
MAIL_FROM=Janus <no-reply@example.com>
SMTP_HOST=smtp.example.com

# Optional: SMTP connection settings. Port 587 with secure=false normally uses
# STARTTLS. Set secure=true for implicit TLS providers, commonly on port 465.
SMTP_PORT=587
SMTP_SECURE=false

# Conditional: SMTP_USER is required when the SMTP relay requires login.
SMTP_USER=replace-me

# Required by the Community deployment profile: SMTP credential secret.
SMTP_PASS_FILE=/run/secrets/api_smtp_password

# Optional: request, Sync and local large-file limits. Defaults are shown.
JANUS_HTTP_JSON_LIMIT=2mb
JANUS_SYNC_REQUIRE_CLIENT_CONTRACT=1
JANUS_SYNC_V6_COMPACTION_CHANGE_THRESHOLD=10000
JANUS_SYNC_V6_BATCH_RATE_LIMIT=120
JANUS_SYNC_V6_RATE_LIMIT_WINDOW_MS=60000
JANUS_SYNC_V6_STORAGE_QUOTA_BYTES=5368709120

# Required in production: persistent path for assembled large files.
JANUS_FILE_STORAGE_ROOT=/var/lib/janus/files

# Required: API-scoped S3/MinIO connection.
JANUS_S3_ENDPOINT=http://minio:9000

# Required: externally reachable HTTPS origin for presigned client uploads and
# downloads. It must match compose.env JANUS_S3_DOMAIN.
JANUS_S3_PUBLIC_ENDPOINT=https://storage.janus.example.com

# Optional: region defaults to us-east-1 when omitted.
JANUS_S3_REGION=us-east-1

# Required: Bucket, API access-key ID and its secret access key.
# Bucket and access-key ID must match compose.env and storage.env.
JANUS_S3_BUCKET=janus-sync
JANUS_S3_ACCESS_KEY_ID=janus-api
JANUS_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/api_s3_secret

# Optional: keep true for MinIO; many hosted S3 services use false.
JANUS_S3_FORCE_PATH_STYLE=true

# Conditional: required when Cloud evolution is enabled.
# The API receives public keys only. Private keys belong exclusively to Worker.
JANUS_EVOLUTION_WORKER_ACTIVE_KEY_ID=evolution-worker-1
JANUS_EVOLUTION_WORKER_PUBLIC_KEYS_JSON_FILE=/run/secrets/evolution_worker_public_keys

# Conditional: required when cross-device Task Memory is enabled.
# The active key ID must exist in the referenced public keyring.
JANUS_TASK_MEMORY_CLOUD_ACTIVE_KEY_ID=task-memory-1
JANUS_TASK_MEMORY_CLOUD_PUBLIC_KEYS_JSON_FILE=/run/secrets/task_memory_public_keys
