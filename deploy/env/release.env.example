# Desktop release/signing profile. This file is not needed to run a local-only
# Desktop, API, Worker or Migrator; it is used only when producing releases.
#
# Labels used below:
#   Required    - required when validating and using the release profile.
#   Optional    - may keep the shown default or be left empty.
#   Conditional - required only for the named platform or publishing feature.

# Required for the release profile: distribution identity.
JANUS_DISTRIBUTION_MODE=community
JANUS_DESKTOP_APP_ID=org.example.janus
JANUS_DESKTOP_PRODUCT_NAME=Janus

# Conditional: required when publishing a generic Desktop update channel.
JANUS_DESKTOP_UPDATE_URL=https://downloads.example.com/janus/releases

# Required for signed Desktop update artifacts.
# Public key is packaged into Desktop; private key remains release-only.
JANUS_DESKTOP_SIGNING_PUBLIC_KEY_FILE=/run/secrets/desktop_update_public_key
JANUS_RELEASE_SIGNING_PRIVATE_KEY_FILE=/run/secrets/desktop_update_private_key

# Conditional: platform signing credentials are supplied only to that platform's
# isolated build job. Leave them commented for platforms you do not build.
# Windows signing:
# CSC_LINK=
# CSC_KEY_PASSWORD_FILE=/run/secrets/windows_certificate_password
# macOS signing and notarization:
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD_FILE=/run/secrets/apple_app_password
# APPLE_TEAM_ID=
