# This profile is used while building a Community Desktop package.
# A local-only Community build can keep every default shown in this file.
#
# Labels used below:
#   Required    - must be set for every build using this profile.
#   Optional    - may be left empty or may keep the shown default.
#   Conditional - required only when the named integration is enabled.

# Optional: distribution and application identity. Defaults are shown.
JANUS_DISTRIBUTION_MODE=community
JANUS_DESKTOP_APP_ID=org.example.janus
JANUS_DESKTOP_PRODUCT_NAME=Janus
JANUS_DESKTOP_EXECUTABLE_NAME=Janus

# Optional: packaged authentication and Cloud defaults.
# Leave both empty to keep the installed Desktop local-only by default.
# Use HTTPS for every non-local deployment.
JANUS_PACKAGED_AUTH_URL=
JANUS_PACKAGED_CLOUD_URL=

# Conditional: Desktop self-update settings.
# To enable Desktop updates, set the update URL and signing public-key file,
# then set JANUS_UPDATES_ENABLED=1. Keep all three disabled/empty otherwise.
JANUS_DESKTOP_UPDATE_URL=
JANUS_DESKTOP_SIGNING_PUBLIC_KEY_FILE=
JANUS_UPDATES_ENABLED=0

# Conditional: Agent update settings.
# To enable Agent updates, set the release API URL and the enabled flag.
JANUS_RELEASE_API_URL=
JANUS_AGENT_UPDATES_ENABLED=0

# Users configure their own model provider in the desktop settings.
# Community builds never embed a Provider API key.
