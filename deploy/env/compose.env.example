# Shared, non-secret values used by Docker Compose while assembling services.
# Keep passwords, secret access keys, Provider keys, tokens and private keys in
# deploy/secrets or the service-specific environment files; do not add them here.
#
# Labels used below:
#   Required    - must be replaced with a real deployment value.
#   Optional    - may keep the shown default unless your deployment differs.
#   Conditional - required only when the named feature is enabled.

# Required: public DNS name served by Caddy. Do not include https:// or a path.
JANUS_DOMAIN=janus.example.com

# Required: separate public DNS name used for signed MinIO uploads/downloads.
# Point it to the same server as JANUS_DOMAIN; do not expose port 9000.
JANUS_S3_DOMAIN=storage.janus.example.com

# Required: MinIO administrator account name. This is not its password.
# Must match storage.env MINIO_ROOT_USER.
MINIO_ROOT_USER=replace-with-random-admin-user

# Required: object-storage Bucket and scoped access-key IDs.
# These are account names, not secret access keys. Keep them consistent with
# storage.env, api.env and worker.env.
JANUS_S3_BUCKET=janus-sync
JANUS_MINIO_API_ACCESS_KEY=janus-api
JANUS_MINIO_WORKER_ACCESS_KEY=janus-worker
