FROM node:22-bookworm-slim

ENV NODE_ENV=production
WORKDIR /opt/janus
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY cloud ./cloud
COPY src ./src
COPY deploy/scripts/with-secrets.mjs ./deploy/scripts/with-secrets.mjs
USER node
CMD ["node", "deploy/scripts/with-secrets.mjs", "--", "node", "cloud/scripts/migrate.mjs"]
